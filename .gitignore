# Configuración local del entorno de desarrollo (no es del proyecto)
.claude/

# Dependencias y artefactos de build
node_modules/
.netlify/
dist/

# Variables de entorno — las claves de servidor van en Netlify, nunca aquí
.env
.env.*
!.env.example

# Sistema operativo / editores
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# Temporales
*.log
*.tmp

# Copias de seguridad de la biblioteca (pósters y GIFs en base64: pesan
# megas y son un volcado de datos, no código)
tools/biblioteca/copias/
tools/biblioteca/manifiestos/
